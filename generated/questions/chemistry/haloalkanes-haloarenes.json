      "status": "draft",
      "stem": "Which of the following compounds will undergo nucleophilic substitution ($\\mathrm{S_N1}$) reaction most readily?",
      "image": null,
      "options": [
        {
          "label": "A",
          "content": "$\\mathrm{(CH_3)_3C-Br}$",
          "is_correct": true
        },
        {
          "label": "B",
          "content": "$\\mathrm{(CH_3)_2CH-Br}$",
          "is_correct": false
        },
        {
          "label": "C",
          "content": "$\\mathrm{CH_3CH_2-Br}$",
          "is_correct": false
        },
        {
          "label": "D",
          "content": "$\\mathrm{CH_3-Br}$",
          "is_correct": false
        }
      ],
      "solution": "The rate of $\\mathrm{S_N1}$ reaction depends on the stability of the carbocation intermediate formed. The tertiary butyl carbocation $\\mathrm{(CH_3)_3C^+}$ is the most stable among the options, hence $\\mathrm{(CH_3)_3C-Br}$ reacts most readily."
    },
    {
      "ref": "CHEM-HAL-002",
      "subtopic": "nucleophilic-substitution",
      "type": "single_correct",
