      "status": "draft",
      "stem": "The proposition $p \\to (\\sim p \\lor q)$ is equivalent to :",
      "image": null,
      "options": [
        {
          "label": "A",
          "content": "$p \\to q$",
          "is_correct": true
        },
        {
          "label": "B",
          "content": "$\\sim p \\to q$",
          "is_correct": false
        },
        {
          "label": "C",
          "content": "$p \\lor q$",
          "is_correct": false
        },
        {
          "label": "D",
          "content": "$p \\land q$",
          "is_correct": false
        }
      ],
      "solution": "$p \\to (\\sim p \\lor q) \\equiv \\sim p \\lor (\\sim p \\lor q)$\n$\\equiv (\\sim p \\lor \\sim p) \\lor q \\equiv \\sim p \\lor q \\equiv p \\to q$."
